# Переменные для PostgreSQL
POSTGRES_DB=realty_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432


# Срок жизни объявления - 30 дней в Проде (и выставлен в коде), 10 минут в Тесте для Теста
MAX_LISTING_DURATION_DD_HH_MM_SS = 30:00:00:00



# Переменные для Django_settings
SECRET_KEY=your_secret_key
HOST_IP=127.0.0.1

DEBUG=True
# для Тестовой среды
USE_SQLITE=True

# Документация API: True — открыта всем (тестовый стенд),
# False/не задано — только админам (прод)
DOCS_PUBLIC=True


# Личный ключ для доступа к API DADATA
DADATA_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"


# ======================================================================
# Переменные для развёртывания на Render + Supabase
# ======================================================================

# Подключение к базе идёт через Supavisor session pooler: прямое подключение
# к db.<ref>.supabase.co работает только по IPv6
# DB_HOST=aws-0-<регион>.pooler.supabase.com
# DB_PORT=5432
# POSTGRES_USER=postgres.<project-ref>
# POSTGRES_DB=postgres
# DB_SSLMODE=require

# Медиа в Supabase Storage. Без SUPABASE_BUCKET работает обычный диск —
# так и нужно локально и в CI
# SUPABASE_BUCKET=media
# SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_REGION=<регион проекта>
# SUPABASE_S3_ACCESS_KEY=
# SUPABASE_S3_SECRET_KEY=
# SUPABASE_PUBLIC_DOMAIN=<project-ref>.supabase.co/storage/v1/object/public/media

# Домены, которые не зашиты в settings.py. Перечисляются через запятую
# EXTRA_ALLOWED_HOSTS=realty-backend.onrender.com
# EXTRA_CSRF_TRUSTED_ORIGINS=https://realty-backend.onrender.com
# EXTRA_CORS_ALLOWED_ORIGINS=https://front.example.com
